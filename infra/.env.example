# infra/.env.example — 비밀값은 비워 둔다(비어 있으면 compose 가 즉시 실패). 실제 값은 `npm run env:init` 으로 생성(infra/.env, git 제외).
COMPOSE_PROJECT_NAME=officeyacht

POSTGRES_USER=officeyacht
POSTGRES_PASSWORD=
POSTGRES_DB=officeyacht_dev

REDIS_PASSWORD=

# 호스트 포트 (loopback 바인딩). 충돌 시 변경하고 apps/server/.env 의 URL 도 맞춘다.
PG_HOST_PORT=5432
REDIS_HOST_PORT=6379
APP_HOST_PORT=3001

WEB_ORIGIN=http://localhost:5173
