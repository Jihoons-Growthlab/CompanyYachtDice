# apps/server/.env.example — 실제 값은 `npm run env:init`(루트) 으로 생성. 비밀값을 커밋하지 않는다.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=log

# 호스트에서 Compose 의 PG/Redis 에 접속 (컨테이너 내부에서는 postgres:5432 / redis:6379)
# 운영(RDS 등)에서는 ?sslmode=require 를 붙이고, ElastiCache TLS 는 rediss:// 를 사용한다.
DATABASE_URL=postgresql://officeyacht:__PASSWORD__@127.0.0.1:5432/officeyacht_dev?schema=public
REDIS_URL=redis://:__PASSWORD__@127.0.0.1:6379/0
REDIS_KEY_PREFIX=oy:

# 제한 시간(ms)
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=10000
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=2000
HEALTH_CHECK_TIMEOUT_MS=1500
# 종료: drain 동안 /health/ready 가 503 을 반환(LB 가 트래픽을 뺄 시간), 이후 강제 종료 한도
SHUTDOWN_DRAIN_MS=0
SHUTDOWN_TIMEOUT_MS=10000
# 리버스 프록시(ALB/Nginx) 뒤에서 실행할 때 true
TRUST_PROXY=false

# 인증 (P1) — 비밀값은 npm run env:init 이 생성한다. 운영에서는 Secrets Manager/SSM 으로 주입.
JWT_ACCESS_SECRET=__GENERATE_ME__
JWT_ISSUER=officeyacht-api
JWT_AUDIENCE=officeyacht-web
ACCESS_TOKEN_TTL_SEC=600
REFRESH_TOKEN_TTL_SEC=1209600
SESSION_ABSOLUTE_TTL_SEC=2592000
# 비우면 production=true, 그 외 false
COOKIE_SECURE=

# API 문서 /docs (비우면 production=false, 그 외 true)
API_DOCS_ENABLED=
# 추가 허용 Origin(쉼표). development 에서는 http://localhost:* 가 자동 허용된다.
EXTRA_ALLOWED_ORIGINS=

# 개발자 테스트 모드(간편 로그인·봇·강제 시작). production 에서는 무시된다.
TEST_MODE=false
# 봇·오토 플레이 한 걸음 지연(ms)
AUTO_STEP_DELAY_MS=700

# 소셜 로그인 — 발급 방법: docs/social-login-setup.md. 비어 있으면 해당 버튼 비활성.
# redirect_uri = ${OAUTH_REDIRECT_BASE_URL}/api/v1/auth/<google|kakao|naver>/callback (기본: WEB_ORIGIN)
OAUTH_REDIRECT_BASE_URL=
# 로그인 완료 후 돌아갈 웹 주소(기본: WEB_ORIGIN)
WEB_APP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
